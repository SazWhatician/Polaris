# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_NAME=polaris-backend
APP_ENV=dev                    # dev | test | prod
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --- Firebase (download service account JSON from Firebase Console -> Project Settings -> Service Accounts) ---
FIREBASE_PROJECT_ID=polaris-dev
# Absolute path inside the container. Mounted via docker-compose.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-sa.json

# --- OpenTelemetry (Jaeger via OTLP gRPC) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=polaris-api

# --- Task queue ---
REDIS_URL=redis://redis:6379

# --- OCR ---
OCR_MAX_PAGES=200
OCR_RENDER_SCALE=2.0

# --- Vector search (Qdrant) ---
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=  # set for Qdrant Cloud

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LangSmith (optional; enables LLM tracing when both are set) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

# --- Optional: emulator overrides for local/CI ---
# FIRESTORE_EMULATOR_HOST=firebase-emulators:8080
# FIREBASE_AUTH_EMULATOR_HOST=firebase-emulators:9099
